# SynapseSEO configuration. Copy to .env.local.
# Empty DATABASE_URL = embedded PGlite (PostgreSQL) stored in .data/postgres (single process only).
DATABASE_URL=
APP_ORIGIN=http://localhost:3200
# Public address for CX short links, API docs and Instagram/Threads media (defaults to the request host).
APP_URL=
ALLOW_SIGNUPS=true
SIGNUP_INVITE_CODE=

# Live data. Without these every metric that needs a web-scale index is DEMO data and labelled as such.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Monthly spending cap across the deployment (USD) and default per-user cap.
GLOBAL_API_BUDGET_USD=50
MAX_MONTHLY_API_USD=50

# Free real-data sources (on by default; set to false to stay fully offline).
ENABLE_AUTOCOMPLETE=true
ENABLE_PAGESPEED=true
ENABLE_NEWS_MENTIONS=true
PAGESPEED_API_KEY=

# AI keys. Each one enables its AI Visibility engine (Google AI Overviews use DataForSEO). Anthropic, OpenAI,
# Gemini or Sarvam also powers the Pre-Publish Optimizer and CX AI (replies, insights, quality, crisis, compose).
# Settings > Integrations shows which key powers which feature.
# Comments stay on their own line: Docker --env-file (production) keeps inline "# ..." as part of the value.
ANTHROPIC_API_KEY=
# Optional Claude model override.
ANTHROPIC_MODEL=
OPENAI_API_KEY=
# Default gpt-6-astra.
OPENAI_MODEL=
# CX Publishing image generation, default gpt-image-1.
OPENAI_IMAGE_MODEL=
GEMINI_API_KEY=
# Default gemini-3.8-flash.
GEMINI_MODEL=
# Sarvam AI (Indian languages). Last in the AI-key order above for writing features; also translates
# Indian-language CX Listening mentions to English before sentiment scoring and handles CX Inbox
# translation to and from Indian languages. Keys: https://dashboard.sarvam.ai
SARVAM_API_KEY=
# Chat model, default sarvam-105b.
SARVAM_MODEL=
PERPLEXITY_API_KEY=
# Agent API preset, or set PERPLEXITY_MODEL to an explicit model instead of the preset.
PERPLEXITY_PRESET=low
PERPLEXITY_MODEL=

# Google Search Console + GA4 (Organic Traffic Insights). OAuth "Web application" client with redirect URI
# <APP_ORIGIN>/api/integrations/google/callback; enable Search Console, Analytics Data and Analytics Admin APIs.
# Alternative to per-user OAuth: one service account for everyone (key JSON raw or base64, or a file path).
# Add its email as a user in Search Console and as Viewer in GA4.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
# Optional separate service account for GA4 (defaults to the one above).
GOOGLE_GA4_SERVICE_ACCOUNT_JSON=
GOOGLE_GA4_SERVICE_ACCOUNT_FILE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts every stored credential (Google OAuth tokens, CX channel/publishing tokens, mailboxes, webhook
# secrets). Required in production; development generates one in .data/app-secret.
APP_SECRET=

# Background scheduler inside the Next.js process (site audits, rank checks, monitors).
LOCAL_WORKER=true

# ---------------------------------------------------------------------------------------------- CX
# Brands can also save their own tokens in CX Settings (encrypted with APP_SECRET); these are server-wide.
# Meta (Facebook + Instagram). The inbox webhook at /api/cx/webhooks/meta needs META_APP_SECRET (signature
# check) and META_VERIFY_TOKEN (any string you also enter in the Meta app).
META_APP_SECRET=
META_VERIFY_TOKEN=
# Inbox, publishing and analytics use a Page token each brand saves in CX Settings; these are server-wide
# fallbacks (Page id, Page token, Instagram business account id).
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Graph API version, default v23.0.
META_GRAPH_VERSION=
# Not read by any API call; only marks the Threads card ready in All Apps.
META_APP_ID=
# WhatsApp Business Cloud API (webhook at /api/cx/webhooks/whatsapp).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# LinkedIn Community Management API (inbox comments/mentions, publishing). Only a token is read: each brand
# saves one in CX Settings; these are the server-wide fallback token and organization URN.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
# Default 202509.
LINKEDIN_API_VERSION=
# X API v2 (bearer token marks X available; posting needs a user token).
X_BEARER_TOKEN=
X_USER_ID=
X_USER_ACCESS_TOKEN=
# YouTube Data API (listening, @handle lookup, channel insights); upload token for video publishing.
YOUTUBE_API_KEY=
YOUTUBE_UPLOAD_ACCESS_TOKEN=
# Reddit "script" app (listening, social profiles).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Bluesky app password (listening keyword search).
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# Threads API (publishing). A token saved in CX Publishing is enough; these are the server-wide fallback.
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
# Not read by any API call; they only mark Threads ready in the channel catalogue.
# Google Business Profile posts need a business.manage token, saved in CX Publishing; these are the
# server-wide fallback location (accounts/…/locations/…) and token.
GBP_LOCATION=
GBP_ACCESS_TOKEN=
# Optional separate client; only marks the All Apps connect card ready.
# Readiness only for now: these mark a channel available but no integration uses them yet.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
VIBER_AUTH_TOKEN=
# Publishing asset storage pickers (S3 bucket, Google Drive picker, OneDrive picker).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CX_ASSETS_S3_BUCKET=
GOOGLE_PICKER_API_KEY=
ONEDRIVE_CLIENT_ID=
