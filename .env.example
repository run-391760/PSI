# SynapseSEO configuration. Copy to .env.local.
# Empty DATABASE_URL = embedded PGlite (PostgreSQL) stored in .data/postgres (single process only).
DATABASE_URL=
APP_ORIGIN=http://localhost:3200
ALLOW_SIGNUPS=true
SIGNUP_INVITE_CODE=

# Live data. Without these every metric that needs a web-scale index is DEMO data and labelled as such.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Monthly spending cap across the deployment (USD) and default per-user cap.
GLOBAL_API_BUDGET_USD=50
MAX_MONTHLY_API_USD=50

# Free real-data sources (on by default; set to false to stay fully offline).
ENABLE_AUTOCOMPLETE=true
ENABLE_PAGESPEED=true
ENABLE_NEWS_MENTIONS=true
PAGESPEED_API_KEY=

# Real AI-answer checks in AI Visibility (each key enables one engine; Google AI Overviews use DataForSEO).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=              # default gpt-6-astra
GEMINI_API_KEY=
GEMINI_MODEL=              # default gemini-3.8-flash
PERPLEXITY_API_KEY=
PERPLEXITY_PRESET=low      # Agent API preset (or set PERPLEXITY_MODEL)

# Google Search Console + GA4 (Organic Traffic Insights). OAuth "Web application" client with redirect URI
# <APP_ORIGIN>/api/integrations/google/callback; enable Search Console, Analytics Data and Analytics Admin APIs.
# Alternative to per-user OAuth: one service account for everyone (key JSON raw or base64, or a file path).
# Add its email as a user in Search Console and as Viewer in GA4.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts stored OAuth tokens. Required in production; development generates one in .data/app-secret.
APP_SECRET=

# Background scheduler inside the Next.js process (site audits, rank checks, monitors).
LOCAL_WORKER=true
